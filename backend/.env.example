APP_NAME=Capybara Coach API
# Use production on Railway; production rejects SQLite and weak JWT secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./capybara_coach.db
STORAGE_DIR=./storage
STORAGE_BACKEND=supabase
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
# Railway production requires a unique value of at least 32 characters.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=documents
SUPABASE_AUDIO_BUCKET=audio

AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_STT_DEPLOYMENT=gpt-4o-mini-transcribe
AZURE_OPENAI_TEXT_DEPLOYMENT=gpt-4.1-mini
